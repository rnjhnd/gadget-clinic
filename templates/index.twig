<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gadget Clinic — Premium Device Repair Service</title>
    <meta name="description" content="Gadget Clinic is a modern repair scheduling platform with real-time SMS alerts, conflict-free booking, and certified PDF service stubs.">

    <!-- Modern Geometric Typography: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('assets/css/index.css') }}">
</head>

<body>

    <!-- Minimalist Studio Header -->
    <header>
        <a href="" class="brand" id="brand-identity">
            <div class="brand-symbol">G</div>
            <span class="brand-title">Gadget Clinic</span>
        </a>

        <div class="nav-status">
            <span class="dot-pulse"></span>
            <span>Live System • Auto-Deployed</span>
        </div>
    </header>

    <!-- Main Workspace -->
    <main>
        {% if error_message %}
            <div style="max-width: 1240px; margin: 16px auto 0; padding: 0 32px;">
                <div style="background-color: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: var(--radius-md); font-size: 14px; font-weight: 500; display: flex; align-items: center; gap: 10px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span>{{ error_message }}</span>
                </div>
            </div>
        {% endif %}

        <div class="hero-grid">
            
            <!-- Left Side: Bold Typography & Google Sign-In Action -->
            <div class="hero-left">
                <span class="category-pill">// IT Service & Repair Drop-off</span>
                <h1 class="hero-title">Fix Your Device.</h1>
                <p class="hero-description">
                    A high-precision scheduling engine built for effortless device drop-offs. Features automated SMS updates, conflict-free booking, and digital service stubs.
                </p>

                <!-- Authentication Entry -->
                <div class="auth-block" id="auth-entry">
                    <p class="auth-prompt">Get started with your Google Account</p>
                    <a href="{{ login_url }}" class="google-pill-btn" id="google-login-btn">
                        <!-- Official Multi-Color Google G -->
                        <svg viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                        </svg>
                        <span>Continue with Google</span>
                    </a>
                    <div class="auth-meta">
                        <span>🔒 OAuth 2.0 Authenticated • SSL Secured</span>
                    </div>
                </div>
            </div>

            <!-- Right Side: Studio Monolith Interactive UI Preview -->
            <div class="hero-right">
                <div class="studio-display-card">
                    <div class="studio-header">
                        <span class="studio-header-title">Live Availability Stream</span>
                        <span class="date-badge">TODAY</span>
                    </div>

                    <div class="slot-stack">
                        <!-- Slot 1 -->
                        <div class="slot-card">
                            <div class="slot-time-block">
                                <span class="slot-time">10:00<span class="slot-meridiem">AM</span></span>
                                <span class="slot-service">Screen & LCD Repair</span>
                            </div>
                            <span class="slot-status-pill pill-confirmed">Confirmed</span>
                        </div>

                        <!-- Slot 2 -->
                        <div class="slot-card">
                            <div class="slot-time-block">
                                <span class="slot-time">02:30<span class="slot-meridiem">PM</span></span>
                                <span class="slot-service">Hardware Diagnostics</span>
                            </div>
                            <span class="slot-status-pill pill-pending">Pending Review</span>
                        </div>
                    </div>

                    <div class="studio-footer-strip">
                        <span>⚡ Automated Semaphore SMS Dispatch</span>
                        <span>📄 Digital Dompdf Passes</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- 3-Column Sculptural Feature Showcase -->
        <div class="feature-monoliths">
            <div class="monolith-card">
                <div class="monolith-num">01 / DISPATCH</div>
                <h3 class="monolith-heading">Automated SMS Sync</h3>
                <p class="monolith-body">
                    Direct integration with Semaphore API provides instant mobile text confirmations to clients and immediate alerts when admins approve or reschedule bookings.
                </p>
            </div>

            <div class="monolith-card">
                <div class="monolith-num">02 / INTEGRITY</div>
                <h3 class="monolith-heading">Conflict-Free Locking</h3>
                <p class="monolith-body">
                    Real-time slot arbitration prevents overlapping drop-offs. The moment a request is active, that exact time slot locks globally across all users.
                </p>
            </div>

            <div class="monolith-card">
                <div class="monolith-num">03 / VERIFICATION</div>
                <h3 class="monolith-heading">Service Drop-off Stubs</h3>
                <p class="monolith-body">
                    One-click generation of certified PDF service passes via Dompdf, complete with reference IDs and customer credentials to attach to your device.
                </p>
            </div>
        </div>
    </main>

    <!-- Clean Minimalist Footer -->
    <footer>
        <div class="footer-inner">
            <span class="footer-brand">Gadget Clinic System</span>
            <span>&copy; {{ "now"|date("Y") }} Gadget Clinic. Built for premium device care.</span>
        </div>
    </footer>

</body>

</html>