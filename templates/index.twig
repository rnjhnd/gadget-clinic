<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In — Gadget Clinic</title>
    <meta name="description" content="Sign in to Gadget Clinic to book repair appointments, review diagnostic quotes, and track your device status.">

    <!-- Modern Geometric Typography: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

    <!-- Favicon Suite -->
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('assets/images/favicon-32x32.png') }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('assets/images/apple-touch-icon.png') }}">

    <link rel="stylesheet" href="{{ asset('assets/css/index.css') }}">
</head>

<body class="auth-page">

    <!-- Minimalist Brand Header -->
    <header class="auth-header">
        <a href="" class="brand" id="brand-identity">
            <div class="brand-symbol" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 7A8 8 0 1 0 20 12h-7" />
                    <path d="M16 9v6" />
                </svg>
            </div>
            <span class="brand-title">Gadget Clinic</span>
        </a>

        <div class="nav-status">
            <span class="dot-pulse"></span>
            <span>Repair Portal</span>
        </div>
    </header>

    <!-- Centered Authentication Workspace -->
    <main class="auth-main">
        <div class="auth-container">
            
            <!-- Auth Card -->
            <div class="auth-card" id="auth-entry">
                
                <!-- Brand Badge -->
                <div class="auth-icon-badge">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                    </svg>
                </div>

                <div class="auth-text-header">
                    <h1 class="auth-title">Sign in to your account</h1>
                    <p class="auth-description">Book repairs, track your device, review quotes.</p>
                </div>

                <!-- Error Message Banner (server-rendered + JS-targetable) -->
                <div class="auth-error-banner" id="auth-error-banner" role="alert" {% if not error_message %}style="display:none;"{% endif %}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    <span id="auth-error-text">{{ error_message }}</span>
                </div>

                <!-- Google Sign-In Action -->
                <div class="auth-actions">
                    <a href="{{ login_url }}" class="google-pill-btn" id="google-login-btn">
                        <!-- Official Multi-Color Google G -->
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                        </svg>
                        <span>Continue with Google</span>
                    </a>
                </div>

                <div class="auth-divider">
                    <span>Secure Access</span>
                </div>

                <!-- Feature Pillars / Assurance -->
                <div class="auth-pillars">
                    <div class="pillar-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                        <span>Google OAuth 2.0</span>
                    </div>
                    <div class="pillar-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 14 14"></polyline>
                        </svg>
                        <span>Live Status Updates</span>
                    </div>
                    <div class="pillar-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                        </svg>
                        <span>Digital Service Stubs</span>
                    </div>
                </div>

            </div>

            <!-- Context Helper Note -->
            <p class="auth-help-note">
                Customer & Staff Access • New clients are registered automatically upon first sign-in.
            </p>

        </div>
    </main>

    <!-- Clean Minimalist Footer -->
    <footer class="auth-footer">
        <div class="footer-inner">
            <span class="footer-brand">Gadget Clinic System</span>
            <span>&copy; {{ "now"|date("Y") }} Gadget Clinic. Device repair scheduling & diagnostics.</span>
        </div>
    </footer>

</body>

</html>