{
  "name": "gadgetclinic/platform",
  "description": "Device repair scheduling, drop-off pass verification, and diagnostics tracking platform built with custom PHP MVC",
  "type": "project",
  "license": "MIT",
  "require": {
    "google/apiclient": "^2.15",
    "dompdf/dompdf": "^3.1",
    "vlucas/phpdotenv": "^5.7",
    "twig/twig": "^3.30",
    "bramus/router": "^1.6",
    "phpmailer/phpmailer": "^7.1",
    "picqer/php-barcode-generator": "^3.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "pre-autoload-dump": "Google\\Task\\Composer::cleanup"
  },
  "extra": {
    "google/apiclient-services": [
      "Oauth2"
    ]
  }
}
